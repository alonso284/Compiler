    var i, a, b, c: int;
    var f, x, y, z: float;
    var s: string;
    var B: bool;
    var C: char;

    begin;
        i := (5 * 3 + 3 + 3 + 3 * 34 * 34) / 5 - 4 + a * ((b - c) % 7);
